{
  "id": "errorRecovery001",
  "name": "Error recovery and alert",
  "active": false,
  "nodes": [
    {
      "id": "f48fe41b-4a5d-4c94-927c-5c919cecd9b7",
      "name": "Execution error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "faf8d61c-6d27-4109-84f6-9863ee20c6fb",
      "name": "Retry ready deliveries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://backend:3000/recovery",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "749b3ce0-661e-4f56-a05e-ac5abd9d57c3",
      "name": "Alert operations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://backend:3000/alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {recovery: $json} }}",
        "options": {
          "timeout": 20000
        }
      }
    }
  ],
  "connections": {
    "Execution error": {
      "main": [
        [
          {
            "node": "Retry ready deliveries",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Retry ready deliveries": {
      "main": [
        [
          {
            "node": "Alert operations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
