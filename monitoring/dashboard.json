{
  "uid": "automation-hub",
  "title": "AI Workflow Automation Hub",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Intake attempts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "workflows_triggered_total",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 2,
      "title": "Workflow failures",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "workflow_failures_total",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 3,
      "title": "Human approvals",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(approvals_total)",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 4,
      "title": "Mean LLM latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(llm_latency_seconds_sum[5m]) / rate(llm_latency_seconds_count[5m])",
          "refId": "A"
        }
      ],
      "options": {}
    }
  ]
}
